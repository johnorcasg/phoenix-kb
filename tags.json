{
  "version": "v1.0",
  "notes": "Phoenix V1 runtime tags. Keep names stable during the 10-day sprint.",
  "stages": {
    "HOT": "Qualified and ready to schedule",
    "NURTURE": "Needs follow-up or missing info",
    "REMOVED": "Not owner / wrong contact",
    "CLOSED": "Do not contact / hard stop",
    "MISC": "Non-seller intents or informational"
  },
  "tags": {
    "QUAL_READY": {
      "stage": "HOT",
      "description": "Owner verified with ≥3 of 4 pillars captured (Motivation + Condition mandatory).",
      "set_when": ["OWNER_VERIFIED", "PILLARS_3OF4"],
      "actions": ["attempt_schedule"]
    },
    "PILLARS_MISSING": {
      "stage": "NURTURE",
      "description": "Owner verified but <3 pillars captured or Motivation/Condition missing.",
      "set_when": ["OWNER_VERIFIED", "PILLARS_LT3_OR_MISSING_MC"],
      "actions": ["nudge_once_24h_then_pause"]
    },
    "WRONG_CONTACT": {
      "stage": "REMOVED",
      "description": "Number not connected to the property and no referral info.",
      "set_when": ["NOT_OWNER_CONFIRMED"],
      "actions": ["exit_conversation"]
    },
    "DO_NOT_CONTACT": {
      "stage": "CLOSED",
      "description": "STOP/DNC request or hard refusal.",
      "set_when": ["STOP_OR_DNC"],
      "actions": ["confirm_optout", "exit_conversation"]
    },

    "INTENT_AGENT": {
      "stage": "MISC",
      "description": "Responder is an agent representing a seller.",
      "set_when": ["AGENT_IDENTIFIED"],
      "actions": ["route_to_DTA_disabled_in_V1"]
    },
    "INTENT_BUYER": {
      "stage": "MISC",
      "description": "Responder is a buyer/investor.",
      "set_when": ["BUYER_IDENTIFIED"],
      "actions": ["route_to_buyer_disabled_in_V1"]
    },
    "NOT_SELLING_YET": {
      "stage": "NURTURE",
      "description": "Owner verified but not ready to sell now.",
      "set_when": ["OWNER_VERIFIED", "DECLINES_TIMING_NOW"],
      "actions": ["enter_nurture_loop_if_enabled"]
    },
    "TENANT_OCCUPANT": {
      "stage": "MISC",
      "description": "Responder is a tenant/occupant, not the decision-maker.",
      "set_when": ["TENANT_IDENTIFIED"],
      "actions": ["request_owner_contact", "exit_if_none"]
    },

    "MULTICONTACT_ACTIVE": {
      "stage": "HOT",
      "description": "Multiple decision-makers tracked for this property.",
      "set_when": ["SECONDARY_DECISION_MAKER_ADDED"],
      "actions": ["link_contacts_same_opportunity"]
    },
    "MULTICONTACT_SPOUSE": {
      "stage": "HOT",
      "description": "Spouse/partner added as Contact2.",
      "set_when": ["SPOUSE_ADDED"],
      "actions": ["create_contact2"]
    },
    "MULTICONTACT_HEIR": {
      "stage": "HOT",
      "description": "Heir/POA added as Contact2/3 (probate/inherited).",
      "set_when": ["HEIR_OR_POA_ADDED"],
      "actions": ["create_contact2_or_3"]
    },
    "MULTICONTACT_COOWNER": {
      "stage": "HOT",
      "description": "Co-owner added and linked.",
      "set_when": ["COOWNER_ADDED"],
      "actions": ["create_contact2", "link_contacts"]
    },

    "OWNER_VERIFIED": {
      "stage": "HOT",
      "description": "Boolean signal tag set upon owner confirmation.",
      "set_when": ["OWNER_YES"],
      "actions": []
    },
    "MOTIVATION_DONE": {
      "stage": "HOT",
      "description": "Motivation captured (pillar flag).",
      "set_when": ["PILLAR_MOTIVATION"],
      "actions": []
    },
    "CONDITION_DONE": {
      "stage": "HOT",
      "description": "Condition captured (pillar flag).",
      "set_when": ["PILLAR_CONDITION"],
      "actions": []
    },
    "TIMELINE_DONE": {
      "stage": "HOT",
      "description": "Timeline captured (pillar flag).",
      "set_when": ["PILLAR_TIMELINE"],
      "actions": []
    },
    "PRICE_DONE": {
      "stage": "HOT",
      "description": "Price expectation captured (pillar flag).",
      "set_when": ["PILLAR_PRICE"],
      "actions": []
    }
  }
}
